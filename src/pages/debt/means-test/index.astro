---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AdSlot from "../../../components/AdSlot.astro";
import Disclaimer from "../../../components/Disclaimer.astro";
import Icon from "../../../components/Icon.astro";
import { US_STATES } from "../../../lib/states";
import ExportBar from '../../../components/ExportBar.astro';
import { stateMedianIncome, STATE_MEDIAN_INCOME_EFFECTIVE_DATE } from "../../../lib/debt/data/stateMedianIncome";

const stateNames: Record<string, string> = Object.fromEntries(US_STATES.map((s) => [s.code, s.name]));
stateNames['DC'] = 'District of Columbia';
const incomeTableRows = Object.entries(stateMedianIncome)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([code, row]) => ({ code, name: stateNames[code] ?? code, s1: row.bySize[1], s2: row.bySize[2], s3: row.bySize[3], s4: row.bySize[4] }));
---

<BaseLayout
  active="means-test"
  title="Chapter 7 Means Test Calculator — Free, No Sign-Up"
  description="See whether your income and expenses pass the Chapter 7 bankruptcy means test. Free, instant, and your figures never leave your device."
>
  <div class="hero">
    <h1><Icon name="scale" />Chapter 7 Means Test &amp; Eligibility Estimator</h1>
    <p class="subtitle">Enter your household details. Nothing here is saved or sent anywhere.</p>
  </div>
  <p class="guide-link"><a href="/debt/guides/chapter-7-means-test/">How this calculation works →</a></p>

  <div class="grid-layout">
    <form id="means-test-form" class="card">
      <div class="field">
        <label class="field-label" for="mt-state"><Icon name="shield" size={16} />State</label>
        <select id="mt-state" name="state" required>
          <option value="">Select a state</option>
          {US_STATES.map((s) => <option value={s.code}>{s.name}</option>)}
        </select>
      </div>

      <div class="field">
        <label class="field-label" for="mt-county">County</label>
        <input id="mt-county" type="text" name="county" placeholder="e.g. Harris" required />
      </div>
      <p class="field-hint">
        Part 2 expense standards currently cover Los Angeles (CA), Harris (TX),
        Miami-Dade (FL), and New York (NY) counties. Additional counties are being added.
        If yours isn't listed, Part 2 will show a "not available" notice.
      </p>

      <div class="field">
        <label class="field-label" for="mt-household">Household size</label>
        <input id="mt-household" type="number" name="householdSize" min="1" value="1" required />
      </div>

      <div class="field">
        <label class="field-label" for="mt-65plus">Household members aged 65 or older</label>
        <input id="mt-65plus" type="number" name="membersAge65OrOlder" min="0" value="0" required />
      </div>

      <div class="field">
        <label class="field-label" for="mt-income">Average gross monthly income (last 6 months)</label>
        <input id="mt-income" type="number" name="monthlyIncome" min="0" step="1" required />
      </div>

      <div class="field">
        <label class="field-label" for="mt-secured">Monthly secured debt payments (mortgage, auto)</label>
        <input id="mt-secured" type="number" name="securedDebt" min="0" step="1" value="0" required />
      </div>

      <div class="field">
        <label class="field-label" for="mt-unsecured">Total unsecured debt</label>
        <input id="mt-unsecured" type="number" name="unsecuredDebt" min="0" step="1" value="0" required />
      </div>

      <button type="submit" class="btn-primary">Check eligibility</button>
    </form>

    <div class="card result-card">
      <h2>Result</h2>
      <div id="means-test-result" role="status" aria-live="polite">
        <div class="metric-grid">
          <div class="metric-card metric-card--accent">
            <span class="metric-label">Status</span>
            <span class="metric-value metric-value--lg">Enter your details</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <ExportBar />

  <AdSlot label="Advertisement" minHeight={250} />

  <section class="card prose mt-worked-example">
    <h2>How it works — Texas example</h2>
    <p>Sarah lives alone in Texas. Her average gross monthly income over the last six months was $4,700, annualizing to <strong>$56,400</strong>. The IRS median for a 1-person Texas household (effective July 15, 2026) is <strong>$66,837</strong>. Because $56,400 &lt; $66,837, Sarah <strong>passes Part 1 automatically</strong> and does not need to complete the expense deduction section (Part 2). She qualifies to file Chapter 7.</p>
    <p>If her income were $5,800/month ($69,600 annualized), she would fail Part 1 and proceed to Part 2. Part 2 subtracts allowed IRS expense standards and actual secured debt payments from her disposable income. If the remaining disposable income over 60 months is below the Chapter 7 threshold, she still qualifies despite failing Part 1.</p>

    <h2>Frequently asked questions</h2>

    <details>
      <summary>What happens if I fail the Part 1 income test?</summary>
      <p>Failing Part 1 only means your income is above the state median — it does not disqualify you from Chapter 7. You proceed to Part 2, which subtracts IRS expense standards (housing, transportation, food, healthcare) plus your actual secured debt payments and certain priority debt payments. If your remaining disposable income over 60 months is below $9,075 (or less than 25% of your unsecured debt), you pass the overall means test. Many filers with above-median income still qualify after Part 2 deductions.</p>
    </details>

    <details>
      <summary>Does my spouse's income count?</summary>
      <p>If you and your spouse live together and file jointly, yes — both incomes are combined. If you file alone but your spouse lives with you, you may still need to include their income (minus their personal expenses) depending on whether you use a marital adjustment. If you are separated and your spouse lives separately, their income is generally excluded. This is one of the more nuanced parts of the means test; consult a bankruptcy attorney if you are married and filing alone.</p>
    </details>

    <details>
      <summary>What if I fail the means test entirely?</summary>
      <p>If you fail both Part 1 and Part 2, there is a presumption of abuse on a Chapter 7 filing. You can rebut it by showing "special circumstances" (job loss, medical crisis, or other extraordinary costs), but that is difficult. Your practical alternative is Chapter 13 bankruptcy, which restructures debt over a 3–5 year repayment plan instead of discharging it. Use the <a href="/debt/compare/">debt comparison calculator</a> to see how Chapter 13 total cost compares to settlement or consolidation for your specific balance.</p>
    </details>
  </section>

  <section class="card prose mt-income-table">
    <h2>State median family income — all 50 states</h2>
    <p>Figures used in the Chapter 7 means test Part 1 comparison. Effective {STATE_MEDIAN_INCOME_EFFECTIVE_DATE}. Source: U.S. Trustee Program / Census Bureau. For households larger than 4, add $11,100 per additional member.</p>
    <div class="mt-table-wrap">
      <table class="mt-table">
        <thead>
          <tr>
            <th scope="col">State</th>
            <th scope="col">1 person</th>
            <th scope="col">2 people</th>
            <th scope="col">3 people</th>
            <th scope="col">4 people</th>
          </tr>
        </thead>
        <tbody>
          {incomeTableRows.map((r) => (
            <tr>
              <td>{r.name} ({r.code})</td>
              <td>${r.s1.toLocaleString()}</td>
              <td>${r.s2.toLocaleString()}</td>
              <td>${r.s3.toLocaleString()}</td>
              <td>${r.s4.toLocaleString()}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <Disclaimer />

  <style>
    .mt-worked-example, .mt-income-table { margin-top: 1.5rem; }
    .mt-table-wrap { overflow-x: auto; margin: 12px 0; border: 1px solid var(--color-border, #e5e7eb); border-radius: 8px; }
    .mt-table { border-collapse: collapse; width: 100%; min-width: 520px; font-size: 13px; font-variant-numeric: tabular-nums; }
    .mt-table th { background: var(--color-surface-alt, #f9fafb); color: var(--color-muted, #6b7280); font-size: 11px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; padding: 8px 12px; text-align: left; border-bottom: 1px solid var(--color-border, #e5e7eb); }
    .mt-table td { padding: 6px 12px; border-bottom: 1px solid var(--color-border, #e5e7eb); }
    .mt-table tr:last-child td { border-bottom: 0; }
    .prose details { border: 1px solid var(--color-border, #e5e7eb); border-radius: 8px; padding: 0 16px; margin: 8px 0; }
    .prose details[open] { border-color: var(--color-accent, #6366f1); }
    .prose summary { display: flex; align-items: center; justify-content: space-between; min-height: 46px; cursor: pointer; font-weight: 600; font-size: 0.925rem; list-style: none; padding: 2px 0; }
    .prose summary::-webkit-details-marker { display: none; }
    .prose summary::after { content: "+"; font-size: 1.1rem; color: var(--color-muted, #6b7280); flex-shrink: 0; margin-left: 12px; }
    .prose details[open] summary::after { content: "−"; }
    .prose details > p { margin-bottom: 14px; font-size: 0.9rem; line-height: 1.65; }
  </style>

  <script>
    import { runMeansTest } from "../../../lib/debt/index";

    const form = document.querySelector<HTMLFormElement>("#means-test-form")!;
    const resultEl = document.querySelector<HTMLDivElement>("#means-test-result")!;

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const monthlyIncome = Number(data.get("monthlyIncome"));

      const result = runMeansTest({
        state: String(data.get("state")),
        county: String(data.get("county")),
        householdSize: Number(data.get("householdSize")),
        membersAge65OrOlder: Number(data.get("membersAge65OrOlder")),
        last6MonthsGrossIncome: Array(6).fill(monthlyIncome),
        monthlySecuredDebtPayments: Number(data.get("securedDebt")),
        totalUnsecuredDebt: Number(data.get("unsecuredDebt")),
      });

      resultEl.innerHTML = renderResult(result);
    });

    function metricCard(label: string, value: string, accent = false): string {
      return `<div class="metric-card${accent ? " metric-card--accent" : ""}">
        <span class="metric-label">${label}</span>
        <span class="metric-value${accent ? " metric-value--lg" : ""}">${value}</span>
      </div>`;
    }

    function renderResult(result: ReturnType<typeof runMeansTest>): string {
      if ("error" in result) {
        return `<div class="metric-grid">${metricCard("Status", "State not supported yet", true)}</div>`;
      }
      if (result.part1 === "pass") {
        return `<div class="metric-grid">
          ${metricCard("Status", "Passes Part 1", true)}
          ${metricCard("State median income", `$${result.stateMedianIncome.toLocaleString()}`)}
          ${metricCard("Annualized income", `$${result.annualizedIncome.toLocaleString()}`)}
        </div>`;
      }
      if (result.part2 === "unknown-local-standards") {
        return `<div class="metric-grid">${metricCard("Status", "County data not available yet", true)}</div>`;
      }
      const passed = result.part2 === "pass";
      return `<div class="metric-grid">
        ${metricCard("Status", passed ? "Passes the means test" : "Does not pass", true)}
        ${metricCard("Disposable monthly income", `$${result.disposableMonthlyIncome?.toFixed(0)}`)}
        ${metricCard("5-year disposable income", `$${result.disposableIncomeOver60Months?.toFixed(0)}`)}
        ${result.projectedChapter13PlanPayment !== undefined ? metricCard("Est. Chapter 13 plan payment", `$${result.projectedChapter13PlanPayment.toFixed(0)}/mo`) : ""}
      </div>`;
    }
  </script>
</BaseLayout>
