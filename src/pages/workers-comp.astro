---
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import Icon from "../components/Icon.astro";
import PercentSlider from "../components/PercentSlider.astro";
import PresetButtons from "../components/PresetButtons.astro";
import { estimateWorkersComp } from "../lib/workersComp";
import ExportBar from '../components/ExportBar.astro';

const defaults = {
  averageWeeklyWage: 900,
  impairmentRatingPct: 15,
  bodyPart: "arm" as const,
};
const initial = estimateWorkersComp(defaults);
const fmt = (n: number) => n.toLocaleString("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
---
<BaseLayout
  title="Workers' Comp Settlement Estimator — Free Calculator"
  description="Estimate a workers' compensation permanent partial disability settlement using the scheduled-loss method. Free, instant, no login."
  active="workers-comp"
>
  <section class="hero">
    <h1><Icon name="document" size={26} /> Workers' Comp Settlement Estimator</h1>
    <p class="subtitle">Estimate a permanent partial disability settlement range using the scheduled-loss method. Free, instant, no data stored.</p>
  </section>

  <div class="grid-layout">
    <form id="calc-form" class="card" aria-label="Workers' comp inputs">
      <div class="field">
        <label for="averageWeeklyWage"><Icon name="currency" size={16} /> Average weekly wage before injury ($)</label>
        <input type="number" id="averageWeeklyWage" min="0" step="1" value={defaults.averageWeeklyWage} required />
        <PresetButtons
          targetId="averageWeeklyWage"
          presets={[
            { label: "$600", value: 600 },
            { label: "$900", value: 900 },
            { label: "$1,200", value: 1200 }
          ]}
        />
      </div>

      <PercentSlider id="impairmentRatingPct" label="Impairment Rating" min={0} max={100} value={defaults.impairmentRatingPct} />

      <div class="field">
        <label for="bodyPart"><Icon name="medical" size={16} /> Injured body part</label>
        <select id="bodyPart">
          <option value="arm" selected>Arm</option>
          <option value="leg">Leg</option>
          <option value="hand">Hand</option>
          <option value="foot">Foot</option>
          <option value="eye">Eye</option>
          <option value="finger">Finger</option>
          <option value="backWholePerson">Back (whole person)</option>
        </select>
      </div>

      <button type="submit" class="btn-primary">Estimate Settlement</button>
    </form>

    <div class="card result-card" id="result" aria-live="polite">
      <h2>Estimated Settlement Range</h2>
      <div class="metric-grid">
        <div class="metric-card metric-card--accent">
          <span class="metric-label"><Icon name="currency" size={14} /> Estimated Range</span>
          <span class="metric-value metric-value--lg" id="range-output">{fmt(initial.estimateLow)} – {fmt(initial.estimateHigh)}</span>
        </div>
        <div class="metric-card">
          <span class="metric-label"><Icon name="briefcase" size={14} /> Weekly Comp Rate</span>
          <span class="metric-value" id="rate-output">{fmt(initial.compensationRate)}</span>
        </div>
        <div class="metric-card">
          <span class="metric-label"><Icon name="document" size={14} /> Scheduled Weeks</span>
          <span class="metric-value" id="weeks-output">{initial.scheduledWeeks} wks</span>
        </div>
      </div>
    </div>
  </div>

  <ExportBar />

  <AdSlot slot_id="mid-content" height="250px" />
  <AdSlot slot_id="bottom-rectangle" height="250px" />

  <section class="card prose wc-faq">
    <h2>Frequently asked questions</h2>

    <details>
      <summary>What is the scheduled-loss method?</summary>
      <p>The scheduled-loss (or scheduled-award) method assigns a fixed number of "weeks of compensation" to specific body parts under a state schedule. Your weekly compensation rate is a percentage of your average weekly wage, typically 66⅔% in most states. The settlement estimate is: scheduled weeks × impairment rating % × weekly rate. This method applies to permanent partial disabilities (PPD) where you lose function in a body part that has a published schedule. It generally does not apply to whole-body or spinal injuries, which use a different "whole person" calculation in most states.</p>
    </details>

    <details>
      <summary>How do state schedules differ?</summary>
      <p>Every state publishes its own schedule — the number of weeks for each body part varies significantly. New York assigns 312 weeks for an arm; Florida uses 280 weeks; Texas uses a modified whole-person approach. Wage caps also differ: many states cap weekly benefits at a percentage of the state average weekly wage, so high earners may be entitled to more weeks on paper but face a ceiling on actual dollars. This calculator uses simplified illustrative figures; always verify with your state workers' compensation board or an attorney before relying on any estimate.</p>
    </details>

    <details>
      <summary>What is an impairment rating and who assigns it?</summary>
      <p>An impairment rating is a percentage that quantifies how much permanent function you lost. It is assigned by a physician — your treating doctor or an independent medical examiner (IME) appointed by the insurer. Most states use the AMA Guides to the Evaluation of Permanent Impairment. If you disagree with the insurer's rating, you can request your own independent evaluation. A 1–2% difference in rating can translate to thousands of dollars in settlement value — getting a second opinion is often worth the cost for significant injuries.</p>
    </details>
  </section>

  <Fragment slot="disclaimer">
    This tool provides a rough estimate using a simplified scheduled-loss (PPD) calculation. Actual
    workers' compensation awards depend on state-specific schedules, wage caps, and case-specific
    factors this tool does not account for.
  </Fragment>
</BaseLayout>

<style>
  .wc-faq { margin-top: 1.5rem; }
  .wc-faq details { border: 1px solid var(--color-border, #e5e7eb); border-radius: 8px; padding: 0 16px; margin: 8px 0; }
  .wc-faq details[open] { border-color: var(--color-accent, #6366f1); }
  .wc-faq summary { display: flex; align-items: center; justify-content: space-between; min-height: 46px; cursor: pointer; font-weight: 600; font-size: 0.925rem; list-style: none; padding: 2px 0; }
  .wc-faq summary::-webkit-details-marker { display: none; }
  .wc-faq summary::after { content: "+"; font-size: 1.1rem; color: var(--color-muted, #6b7280); flex-shrink: 0; margin-left: 12px; }
  .wc-faq details[open] summary::after { content: "−"; }
  .wc-faq details > p { margin-bottom: 14px; font-size: 0.9rem; line-height: 1.65; }
</style>

<script>
  import { estimateWorkersComp, type BodyPart } from "../lib/workersComp";

  const fmt = (n: number) =>
    n.toLocaleString("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });

  document.getElementById("calc-form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const input = {
      averageWeeklyWage: Number((document.getElementById("averageWeeklyWage") as HTMLInputElement).value) || 0,
      impairmentRatingPct: Number((document.getElementById("impairmentRatingPct") as HTMLInputElement).value) || 0,
      bodyPart: (document.getElementById("bodyPart") as HTMLSelectElement).value as BodyPart
    };
    const result = estimateWorkersComp(input);
    document.getElementById("range-output")!.textContent = `${fmt(result.estimateLow)} – ${fmt(result.estimateHigh)}`;
    document.getElementById("rate-output")!.textContent = fmt(result.compensationRate);
    document.getElementById("weeks-output")!.textContent = `${result.scheduledWeeks} wks`;
  });
</script>
