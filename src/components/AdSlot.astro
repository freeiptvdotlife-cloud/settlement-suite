---
interface Props {
  slot_id?: string;
  label?: string;
  height?: string;
  minHeight?: number;
}
const { slot_id, label = "Advertisement", height, minHeight } = Astro.props;
const resolvedHeight = height ?? (minHeight ? `${minHeight}px` : "250px");
---

<!--
  Zero-CLS ad container: fixed min-height + height reserved at parse time,
  never resized after mount, never adjacent to interactive form controls.
  Swap the placeholder for the real <ins class="adsbygoogle"> unit once the
  AdSense property is approved — the reserved box model keeps CLS at 0.00
  either way.
-->
<div class="ad-slot" data-ad-slot={slot_id} style={`min-height:${resolvedHeight}; height:${resolvedHeight};`}>
  <span class="ad-slot__label">{label}</span>
</div>
