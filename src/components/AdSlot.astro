---
interface Props {
  slot_id?: string;
  label?: string;
  height?: string;
  minHeight?: number;
}
const { slot_id, label = "Advertisement", height, minHeight } = Astro.props;
const resolvedHeight = height ?? (minHeight ? `${minHeight}px` : "250px");
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT as string | undefined;
const isLive = Boolean(client && slot_id);
---

<div class="ad-slot" style={`min-height:${resolvedHeight}; height:${resolvedHeight};`}>
  <span class="ad-slot__label">{label}</span>
  {isLive && (
    <ins
      class="adsbygoogle"
      style="display:block;width:100%;height:100%"
      data-ad-client={client}
      data-ad-slot={slot_id}
      data-ad-format="auto"
      data-full-width-responsive="true"
    />
  )}
</div>
