---
// Two paths, chosen at build time by whether PUBLIC_ADSENSE_CLIENT is set:
//
// 1. Configured: loads Google's Funding Choices CMP (geo-targeted, certified).
// 2. Not configured: minimal first-party fallback banner. EU-only via geo_consent cookie.
---

<script
  is:inline
  define:vars={{
    client: import.meta.env.PUBLIC_ADSENSE_CLIENT,
  }}
>
  (function () {
    var STORAGE_KEY = 'fn_consent_v1';
    var GRANTED = {
      ad_storage: 'granted',
      ad_user_data: 'granted',
      ad_personalization: 'granted',
      analytics_storage: 'granted',
    };
    var DENIED = {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
    };

    function update(state) { window.gtag('consent', 'update', state); }
    function save(choice) {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ choice: choice, at: Date.now() })); } catch (e) {}
    }
    function readSaved() {
      try { var r = localStorage.getItem(STORAGE_KEY); return r ? JSON.parse(r) : null; } catch (e) { return null; }
    }

    // --- Path 1: Google's certified CMP ---
    if (client) {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://fundingchoicesmessages.google.com/i/' + client + '?ers=1';
      document.head.appendChild(s);
      (function signalGooglefcPresent() {
        if (!window.frames['googlefcPresent']) {
          if (document.body) {
            var iframe = document.createElement('iframe');
            iframe.style.cssText = 'display:none;width:0;height:0;border:none;';
            iframe.name = 'googlefcPresent';
            document.body.appendChild(iframe);
          } else { setTimeout(signalGooglefcPresent, 0); }
        }
      })();
      window.__reopenConsent = function () {
        if (window.googlefc && window.googlefc.showRevocationMessage) window.googlefc.showRevocationMessage();
      };
    }

    // --- Path 2: fallback banner ---
    function showFallbackBanner() {
      var el = document.getElementById('consent-banner');
      if (!el) return;
      el.hidden = false;
      el.querySelector('[data-consent="accept"]').addEventListener('click', function () {
        update(GRANTED); save('accepted'); el.hidden = true;
      });
      el.querySelector('[data-consent="reject"]').addEventListener('click', function () {
        update(DENIED); save('rejected'); el.hidden = true;
      });
      window.__reopenConsent = function () { el.hidden = false; };
    }

    function initFallback() {
      if (navigator.globalPrivacyControl === true && !readSaved()) { save('gpc'); return; }
      var saved = readSaved();
      if (saved) { update(saved.choice === 'accepted' ? GRANTED : DENIED); return; }
      // Only show banner for EU visitors (geo_consent=required cookie).
      var geoCookie = document.cookie.split('; ').find(function (r) { return r.startsWith('geo_consent='); });
      var euVisitor = geoCookie ? geoCookie.split('=')[1] === 'required' : false;
      if (euVisitor) showFallbackBanner();
    }

    if (!client) {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFallback);
      } else {
        setTimeout(initFallback, 0);
      }
    } else {
      setTimeout(function () { if (!window.googlefc) initFallback(); }, 2000);
    }
  })();
</script>

<div
  id="consent-banner"
  class="consent-banner"
  hidden
  role="dialog"
  aria-live="polite"
  aria-label="Cookie and privacy choices"
>
  <p>We use cookies for advertising and analytics. See our <a href="/privacy/">privacy policy</a>.</p>
  <div class="consent-banner__actions">
    <button type="button" class="btn-secondary" data-consent="reject">Reject non-essential</button>
    <button type="button" class="btn-primary" data-consent="accept">Accept</button>
  </div>
</div>

<style>
  .consent-banner {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: 16px;
    z-index: 40;
    max-width: 640px;
    margin-inline: auto;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 28px rgb(0 0 0 / 0.18);
    padding: 16px;
    display: grid;
    gap: 12px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .consent-banner[hidden] { display: none; }
  .consent-banner p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .consent-banner a { color: var(--accent); }
  .consent-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: flex-end;
  }
  .btn-secondary, .btn-primary {
    padding: 0.45rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    cursor: pointer;
    min-height: 36px;
  }
  .btn-secondary { background: var(--bg-inset); color: var(--text-muted); }
  .btn-primary { background: var(--accent); color: #fff; border-color: var(--accent); }
</style>
