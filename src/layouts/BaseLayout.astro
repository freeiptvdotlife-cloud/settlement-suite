---
import AdLoader from "../components/AdLoader.astro";
import ConsentManager from "../components/ConsentManager.astro";
import ConsentMode from "../components/ConsentMode.astro";
import GA4 from "../components/GA4.astro";
import Icon from "../components/Icon.astro";

export interface Props {
  title: string;
  description: string;
  active?: "settlement" | "child-support" | "workers-comp" | "structured-settlement" | "annuity-solver" | "lawsuit-loan" | "ssdi-backpay" | "alimony-hub" | "probate-hub" | "means-test" | "debt-compare" | "dti" | "sol" | "guides" | "personal-injury";
  /** Bold lead-in for the footer disclaimer. Defaults to "Not legal advice." */
  disclaimerLead?: string;
}
const { title, description, active, disclaimerLead = "Not legal advice." } = Astro.props;

const isHome = Astro.url.pathname === "/";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://recoverynumbers.com").toString();

const breadcrumbItems = isHome ? [] : [
  { name: "Recovery Numbers", item: Astro.site?.toString() ?? "https://recoverynumbers.com/" },
  { name: title, item: canonicalUrl },
];

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Recovery Numbers",
  url: Astro.site?.toString() ?? "https://recoverynumbers.com/",
};

const breadcrumbSchema = breadcrumbItems.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((b, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: b.name,
    item: b.item,
  })),
} : null;

const navItems = [
  { href: "/", label: "Settlement", key: "settlement", icon: "scale" },
  { href: "/settlement/personal-injury-calculator/", label: "Personal Injury", key: "personal-injury", icon: "scale" },
  { href: "/workers-comp/", label: "Workers' Comp", key: "workers-comp", icon: "briefcase" },
  { href: "/settlement/structured-settlement/", label: "Structured Settlement", key: "structured-settlement", icon: "coins" },
  { href: "/settlement/annuity-value-solver/", label: "Annuity Solver", key: "annuity-solver", icon: "clock" },
  { href: "/settlement/lawsuit-loan-cost-estimator/", label: "Lawsuit Loan", key: "lawsuit-loan", icon: "shield" },
  { href: "/settlement/ssdi-back-pay-calculator/", label: "SSDI Back Pay", key: "ssdi-backpay", icon: "shield" },
  { href: "/family-law/alimony-calculator/", label: "Alimony", key: "alimony-hub", icon: "scale" },
  { href: "/probate/probate-fee-calculator/", label: "Probate Fees", key: "probate-hub", icon: "document" },
  { href: "/debt/means-test/", label: "Means Test", key: "means-test", icon: "shield" },
  { href: "/debt/compare/", label: "Compare Paths", key: "debt-compare", icon: "exchange" },
  { href: "/debt/dti/", label: "DTI & Recovery", key: "dti", icon: "chart" },
  { href: "/debt/statute-of-limitations/", label: "SOL Checker", key: "sol", icon: "clock" },
  { href: "/debt/child-support/", label: "Child Support", key: "child-support", icon: "document" },
  { href: "/debt/guides/", label: "Guides", key: "guides", icon: "document" },
] as const;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ConsentMode />
  <GA4 />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="color-scheme" content="light dark" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="stylesheet" href="/theme.css" />
  <link
    rel="icon"
    type="image/svg+xml"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⚖️</text></svg>"
  />
  <script is:inline>
    (function () {
      // Lets the CSS collapse the 15-link nav into the drawer on phones. Without JS the nav
      // stays inline (tall, but usable) instead of showing a button that does nothing.
      document.documentElement.classList.add("js");
      var stored = null;
      try { stored = localStorage.getItem("theme"); } catch (e) {}
      var theme = stored || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.setAttribute("data-theme", theme);
    })();
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
</head>
<body>
  <div class="app-shell">
    <div class="print-header" aria-hidden="true">
      <strong>Recovery Numbers</strong> · recoverynumbers.com &nbsp;|&nbsp; <span id="print-date"></span>
    </div>
    <header class="app-header">
      <a class="brand" href="/">
        <Icon name="scale" size={22} />
        <span>Recovery Numbers</span>
      </a>
      <div class="header-controls">
        <button
          type="button"
          id="theme-toggle"
          class="theme-toggle"
          aria-label="Toggle dark mode"
          aria-pressed="false"
        >
          <Icon name="sun" size={18} />
          <Icon name="moon" size={18} />
        </button>
        <button
          type="button"
          class="nav-ham"
          id="nav-ham"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Open menu"
        >
          <span></span><span></span><span></span>
        </button>
      </div>
      {/* 15 links never fit beside the brand, so the nav owns its own row (and wraps inside it)
          instead of pushing the theme toggle onto a row of its own. */}
      <nav class="app-nav" aria-label="Calculators">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`nav-link ${item.key === active ? "nav-link--active" : ""}`}
            aria-current={item.key === active ? "page" : undefined}
          >
            <Icon name={item.icon} size={14} />
            {item.label}
          </a>
        ))}
      </nav>
      {/* Same links as .app-nav, shown only on narrow screens where the 15-link row is unusable.
          The drawer is hidden by CSS unless the inline script marks the document as JS-capable,
          so a no-JS phone keeps the plain wrapped nav instead of an inert button. */}
      <nav class="mobile-nav" id="mobile-nav" aria-hidden="true" aria-label="Calculators">
        {navItems.map((item) => (
          <a href={item.href} aria-current={item.key === active ? "page" : undefined}>
            <Icon name={item.icon} size={16} />
            {item.label}
          </a>
        ))}
      </nav>
    </header>

    <main class="app-main">
      <slot />
    </main>

    <footer class="app-footer">
      <div class="disclaimer-block" role="note">
        <Icon name="warning" size={20} />
        <div>
          <strong>{disclaimerLead}</strong> <slot name="disclaimer" />
        </div>
      </div>
      <nav class="footer-links" aria-label="Site links">
        <a href="/about/">About</a>
        <a href="/methodology/">Methodology</a>
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
      </nav>
    </footer>
  </div>
  <AdLoader />
  <ConsentManager />
</body>
</html>

<script>
  const pd = document.getElementById("print-date");
  if (pd) pd.textContent = "Generated: " + new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

  const toggle = document.getElementById("theme-toggle");
  const root = document.documentElement;

  function syncPressedState() {
    toggle?.setAttribute("aria-pressed", String(root.getAttribute("data-theme") === "dark"));
  }
  syncPressedState();

  toggle?.addEventListener("click", () => {
    const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try {
      localStorage.setItem("theme", next);
    } catch (e) {
      // localStorage unavailable (private browsing) — theme still applies for this session
    }
    syncPressedState();
  });

  // Mobile drawer. Markup mirrors recoverynumbers-debt's header so the two apps of the domain
  // behave the same; same markup, same aria contract: aria-expanded on the button,
  // aria-hidden on the drawer.
  const ham = document.getElementById("nav-ham");
  const mobileNav = document.getElementById("mobile-nav");

  function setMenu(open: boolean) {
    ham?.setAttribute("aria-expanded", String(open));
    ham?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    mobileNav?.setAttribute("aria-hidden", String(!open));
  }

  ham?.addEventListener("click", () => {
    setMenu(ham.getAttribute("aria-expanded") !== "true");
  });
  // A jump link should not leave the drawer open behind the new page position.
  mobileNav?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => {
      setMenu(false);
    });
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMenu(false);
  });
  // Reset when the viewport grows past the drawer breakpoint (the CSS hides it there anyway,
  // but the button state must not be left stale for a later resize back down).
  window.matchMedia("(min-width: 761px)").addEventListener("change", (e) => {
    if (e.matches) setMenu(false);
  });
</script>
